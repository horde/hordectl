{
    "name": "horde/hordectl",
    "description": "Scenario deployer library",
    "type": "library",
    "homepage": "https://www.horde.org",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Ralf Lang",
            "email": "ralf.lang@ralf-lang.de",
            "role": "lead"
        }
    ],
    "time": "2026-05-19",
    "repositories": [],
    "require": {
        "php": "^8.2",
        "horde/util": "^3 || dev-FRAMEWORK_6_0",
        "horde/injector": "^3 || dev-FRAMEWORK_6_0",
        "horde/cli_modular": "^3 || dev-FRAMEWORK_6_0",
        "horde/cli": "^3 || dev-FRAMEWORK_6_0",
        "horde/http": "^3 || dev-FRAMEWORK_6_0",
        "horde/argv": "^3 || dev-FRAMEWORK_6_0",
        "horde/yaml": "^3 || dev-FRAMEWORK_6_0",
        "horde/group": "^3 || dev-FRAMEWORK_6_0",
        "horde/phpconfigfile": "^1 || ^0 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {
        "horde/test": "^3 || dev-FRAMEWORK_6_0",
        "phpunit/phpunit": "^12 || ^11 || ^9 || ^10.5"
    },
    "suggest": {},
    "autoload": {
        "psr-4": {
            "Horde\\Hordectl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Hordectl\\Test\\": "test/",
            "Horde\\Hordectl\\Test\\Fixtures\\": "test/fixtures/"
        }
    },
    "bin": [
        "bin/hordectl"
    ],
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "1.x-dev"
        }
    }
}
