{
    "name": "horde/hordectl",
    "description": "Scenario deployer library",
    "type": "library",
    "homepage": "https://www.horde.org",
    "license": "LGPL-2.1",
    "authors": [
        {
            "name": "Ralf Lang",
            "email": "lang@b1-systems.de",
            "role": "lead"
        }
    ],
    "time": "2025-05-07",
    "repositories": [],
    "require": {
        "php": "^8.2",
        "horde/util": "^3",
        "horde/injector": "^3",
        "horde/cli_modular": "^3",
        "horde/cli": "^3",
        "horde/argv": "^3",
        "horde/yaml": "^3",
        "horde/group": "^3"
    },
    "require-dev": {
        "horde/test": "^3",
        "phpunit/phpunit": "^12 || ^11 || ^9 || ^10.5"
    },
    "suggest": {},
    "autoload": {
        "psr-4": {
            "Horde\\Hordectl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Hordectl\\Test\\": "test/"
        }
    },
    "bin": [
        "bin/hordectl"
    ],
    "config": {
        "allow-plugins": []
    }
}