#!/usr/bin/env php
<?php
/**
 * hordectl - Command-line management tool for Horde installations
 *
 * Copyright 2013-2026 The Horde Project (http://www.horde.org/)
 *
 * See the enclosed file LICENSE for license information (LGPL). If you
 * did not receive this file, see http://www.horde.org/licenses/lgpl21.
 */

if (strpos('@php_dir@', '@php_dir') === 0) {
    set_include_path(dirname(__DIR__) . DIRECTORY_SEPARATOR . 'lib' . PATH_SEPARATOR . get_include_path());
}

// Load Composer autoloader
if (isset($GLOBALS['_composer_autoload_path'])) {
    // Running via Composer bin proxy (e.g., vendor/bin/hordectl)
    require_once $GLOBALS['_composer_autoload_path'];
} else {
    // Try standalone autoloader locations
    $autoloaders = [
        __DIR__ . '/../vendor/autoload.php', // hordectl standalone
        __DIR__ . '/../../../autoload.php',  // installed as dependency
    ];

    $found = false;
    foreach ($autoloaders as $autoloader) {
        if (file_exists($autoloader)) {
            require_once $autoloader;
            $found = true;
            break;
        }
    }

    if (!$found) {
        fwrite(STDERR, "Error: Composer autoloader not found.\n");
        fwrite(STDERR, "Run 'composer install' in " . dirname(__DIR__) . "\n");
        exit(1);
    }
}

// Handle version command early (minimal dependencies)
if (isset($argv[1]) && in_array($argv[1], ['version', '--version', '-v'], true)) {
    $version = 'unknown';
    $hordeYml = __DIR__ . '/../.horde.yml';
    if (file_exists($hordeYml)) {
        $data = \Horde\Yaml\Yaml::loadFile($hordeYml);
        $version = $data['version']['release'] ?? 'unknown';
    }
    echo "hordectl version {$version}\n";
    exit(0);
}

// Run CLI
$parameters = ['argv' => $GLOBALS['argv']];
$exitCode = \Horde\Hordectl\Cli::main($parameters);
exit($exitCode);
